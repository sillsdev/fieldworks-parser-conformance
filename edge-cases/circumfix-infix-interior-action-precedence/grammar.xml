          <Representations>
            <Representation>x</Representation>
          </Representations>
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny_interior-action">
        <Name>Any_interior-action</Name>
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncAny_non-first-allomorph">
        <Name>Any_non-first-allomorph</Name>
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncAny_reduplication">
        <Name>Any_reduplication</Name>
      </FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="table1_interior-action" morphologicalRuleOrder="unordered" morphologicalRules="mrCircInfix_interior-action mrMixed_non-first-allomorph mrCircRedup_reduplication">
        <Name>Main_interior-action</Name>
        <MorphologicalRuleDefinitions>
          <!-- Two LHS parts (p1 = the root's first segment, p2 = the remainder), so the RHS can
               place an InsertSegments action strictly BETWEEN their two CopyFromInput actions
               while ALSO leading with one InsertSegments and trailing with another - the
               simultaneously-circumfixing-and-infixing shape census C3 names. -->
          <MorphologicalRule id="mrCircInfix_interior-action" requiredPartsOfSpeech="posRoot2_interior-action" outputPartOfSpeech="posRoot2_interior-action">
            <Name>circInfix_interior-action</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subCircInfix_interior-action">
                <MorphologicalInput>
                  <PhoneticSequence id="p1_interior-action">
                    <SimpleContext naturalClass="ncAny_interior-action"/>
                  </PhoneticSequence>
                  <PhoneticSequence id="p2_interior-action">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="ncAny_interior-action"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <InsertSegments>
                    <PhoneticShape>ke</PhoneticShape>
                  </InsertSegments>
                  <CopyFromInput index="p1_interior-action"/>
                  <InsertSegments>
                    <PhoneticShape>z</PhoneticShape>
                  </InsertSegments>
                  <CopyFromInput index="p2_interior-action"/>
                  <InsertSegments>
                    <PhoneticShape>an</PhoneticShape>
                  </InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>CIRCINFIX_interior-action</MorphemeId>
          </MorphologicalRule>
          <!-- Allomorph 0 (document order): ORDINARY suffix, "-s". Alone, this would classify
               Role::Suffix from `rule_role` (allomorph 0). -->
          <!-- Allomorph 1 (document order): CIRCUMFIX, "ke-...-an" - leading InsertSegments,
               one CopyFromInput, trailing InsertSegments. This is the allomorph census C1 names:
               declared SECOND, so a first-allomorph-only classifier never sees it. -->
          <MorphologicalRule id="mrMixed_non-first-allomorph" requiredPartsOfSpeech="posRoot_non-first-allomorph" outputPartOfSpeech="posRoot_non-first-allomorph">
            <Name>mixed_non-first-allomorph</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSuffix_non-first-allomorph">
                <MorphologicalInput>
                  <PhoneticSequence id="stemA_non-first-allomorph">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="ncAny_non-first-allomorph"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="stemA_non-first-allomorph"/>
                  <InsertSegments>
                    <PhoneticShape>o</PhoneticShape>
                  </InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
              <MorphologicalSubrule id="subCircum_non-first-allomorph">
                <MorphologicalInput>
                  <PhoneticSequence id="stemB_non-first-allomorph">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="ncAny_non-first-allomorph"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <InsertSegments>
                    <PhoneticShape>hf</PhoneticShape>
                  </InsertSegments>
                  <CopyFromInput index="stemB_non-first-allomorph"/>
                  <InsertSegments>
                    <PhoneticShape>dl</PhoneticShape>
                  </InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>MIXED_non-first-allomorph</MorphemeId>
          </MorphologicalRule>
          <!-- ONE LHS part (p1 = the whole root), so the RHS can CopyFromInput it TWICE (the
               census C2 reduplication trigger - the same PartRef echoed >= 2 times) while ALSO
               leading with one InsertSegments and trailing with another - the
               simultaneously-circumfixing-and-reduplicating shape census C2 names. -->
          <MorphologicalRule id="mrCircRedup_reduplication" requiredPartsOfSpeech="posRootC2_reduplication" outputPartOfSpeech="posRootC2_reduplication">
            <Name>circRedup_reduplication</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subCircRedup_reduplication">
                <MorphologicalInput>
                  <PhoneticSequence id="p1_reduplication">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="ncAny_reduplication"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <InsertSegments>
                    <PhoneticShape>vr</PhoneticShape>
                  </InsertSegments>
                  <CopyFromInput index="p1_reduplication"/>
                  <CopyFromInput index="p1_reduplication"/>
                  <InsertSegments>
                    <PhoneticShape>qx</PhoneticShape>
                  </InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>CIRCREDUP_reduplication</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eRoot2_interior-action" partOfSpeech="posRoot2_interior-action">
            <Allomorphs>
              <Allomorph id="aRoot2_interior-action">
                <PhoneticShape>bat</PhoneticShape>
              </Allomorph>
            </Allomorphs>
            <MorphemeId>ROOT2_interior-action</MorphemeId>
            <Gloss>root2</Gloss>
