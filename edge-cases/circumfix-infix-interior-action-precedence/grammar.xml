              <Allomorph id="aRoot_non-first-allomorph">
                <PhoneticShape>jgp</PhoneticShape>
              </Allomorph>
            </Allomorphs>
            <MorphemeId>ROOT_non-first-allomorph</MorphemeId>
            <Gloss>root</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eRootC2_reduplication" partOfSpeech="posRootC2_reduplication">
            <Allomorphs>
              <Allomorph id="aRootC2_reduplication">
                <PhoneticShape>àqw</PhoneticShape>
              </Allomorph>
            </Allomorphs>
            <MorphemeId>ROOTC2_reduplication</MorphemeId>
            <Gloss>rootC2</Gloss>
          </LexicalEntry>
