<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>CircumfixInfixInteriorActionPrecedence</Name>
    <!-- Pins census C3 (docs/conformance/circumfix-structural-composite-census.md,
         openspec/changes/plan-construct-coverage-completion task 4.3b): ONE allomorph
         (subCircInfix) whose RHS is SIMULTANEOUSLY circumfixing (an InsertSegments before the
         FIRST CopyFromInput and another InsertSegments after the LAST one) AND infixing (a THIRD
         InsertSegments sits strictly BETWEEN the two CopyFromInput actions). Before the fix,
         `crate::emit::classify_affix`'s interior-action test ran first and returned Role::Infix
         the instant it saw that interior InsertSegments - the wrong taxonomic label for a morph
         that genuinely wraps the root on both sides, and one that routed this allomorph's rule to
         `crate::preexpand` instead of `build_structural_composites`. See STAGING.md's own
         "important correction" section: `crate::preexpand` ALSO resynthesizes via the real engine
         (`pg_rules::morph::synthesize_cached`), so this was a misclassification/ownership defect,
         not an actual recall loss - confirmed by testing, not assumed. After the fix, the
         leading-AND-trailing test runs FIRST, so this shape now classifies CircumfixPrefix and is
         routed to `build_structural_composites` instead. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posRoot2_interior-action">
        <Name>root2_interior-action</Name>
      </PartOfSpeech>
      <PartOfSpeech id="posRoot_non-first-allomorph">
        <Name>root_non-first-allomorph</Name>
      </PartOfSpeech>
      <PartOfSpeech id="posRootC2_reduplication">
        <Name>rootC2_reduplication</Name>
      </PartOfSpeech>
    </PartsOfSpeech>
    <!-- No PhonologicalRule/MetathesisRule element at all - pure morphotactics, so requires: []
         (mechanically derived, per the conformance-grammars skill's own note). -->
    <CharacterDefinitionTable id="table1_interior-action">
      <Name>Main_interior-action</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cB_interior-action">
          <Representations>
            <Representation>b</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cA_interior-action">
          <Representations>
            <Representation>a</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cT_interior-action">
          <Representations>
            <Representation>t</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cK_interior-action">
          <Representations>
            <Representation>k</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cE_interior-action">
          <Representations>
            <Representation>e</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cZ_interior-action">
          <Representations>
            <Representation>z</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cN_interior-action">
          <Representations>
            <Representation>n</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cM_non-first-allomorph">
          <Representations>
            <Representation>j</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cI_non-first-allomorph">
          <Representations>
            <Representation>g</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cT_non-first-allomorph">
          <Representations>
            <Representation>p</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cS_non-first-allomorph">
          <Representations>
            <Representation>o</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cK_non-first-allomorph">
          <Representations>
            <Representation>h</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cE_non-first-allomorph">
          <Representations>
            <Representation>f</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cA_non-first-allomorph">
          <Representations>
            <Representation>d</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cN_non-first-allomorph">
          <Representations>
            <Representation>l</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cT_reduplication">
          <Representations>
            <Representation>à</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cA_reduplication">
          <Representations>
            <Representation>q</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cM_reduplication">
          <Representations>
            <Representation>w</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cK_reduplication">
          <Representations>
            <Representation>v</Representation>
          </Representations>
        </SegmentDefinition>
        <SegmentDefinition id="cE_reduplication">
          <Representations>
            <Representation>r</Representation>
          </Representations>
