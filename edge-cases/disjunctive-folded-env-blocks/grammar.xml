<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<!-- An earlier suffix allomorph whose left context is folded into its input pattern, then the lexeme-form
     allomorph. HCLoader builds a FieldWorks suffix allomorph with environment "/ n _" as the input pattern
     "stem* n" and no AllomorphEnvironment. Allomorph 0 (input stem* n, adds ka) comes before allomorph 1
     (input stem+, adds ku). For banku, allomorph 0 matches the stem ban and, with no environments, its
     disjunctive property stops allomorph 1 from applying, so ban+ku has no parse (C# and PanGloss agree).
     Pins sillsdev/PanGloss#444 (Motif #316). -->
<HermitCrabInput>
  <Language>
    <Name>EarlierAllomorphBreaksSynthesis</Name>
    <PartsOfSpeech><PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech></PartsOfSpeech>
    <CharacterDefinitionTable id="tbl">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="ca"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cb"><Representations><Representation>b</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="ck"><Representations><Representation>k</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cn"><Representations><Representation>n</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cs"><Representations><Representation>s</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cu"><Representations><Representation>u</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
      <SegmentNaturalClass id="ncN"><Name>nOnly</Name><Segment segment="cn" /></SegmentNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="tbl" morphologicalRuleOrder="unordered" morphologicalRules="mrDat">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrDat" requiredPartsOfSpeech="posN">
            <Name>mrDat</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subKa">
                <MorphologicalInput>
                  <PhoneticSequence id="kaStem"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence>
                  <PhoneticSequence id="kaN"><SimpleContext naturalClass="ncN" /></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="kaStem" /><CopyFromInput index="kaN" /><InsertSegments><PhoneticShape>ka</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
              <MorphologicalSubrule id="subKu">
                <MorphologicalInput><PhoneticSequence id="kuStem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="kuStem" /><InsertSegments><PhoneticShape>ku</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>DAT</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eBan" partOfSpeech="posN"><Allomorphs><Allomorph id="aBan"><PhoneticShape>ban</PhoneticShape></Allomorph></Allomorphs><MorphemeId>BAN</MorphemeId></LexicalEntry>
          <LexicalEntry id="eBas" partOfSpeech="posN"><Allomorphs><Allomorph id="aBas"><PhoneticShape>bas</PhoneticShape></Allomorph></Allomorphs><MorphemeId>BAS</MorphemeId></LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
