              </PhoneticSequence>
            </PhoneticOutput>
            <Environment>
              <RightEnvironment>
                <PhoneticTemplate>
                  <PhoneticSequence>
                    <OptionalSegmentSequence min="0" max="2">
                      <SimpleContext naturalClass="ncCons_bounded-quantifier"/>
                    </OptionalSegmentSequence>
                    <SimpleContext naturalClass="ncTrig_bounded-quantifier"/>
                  </PhoneticSequence>
                </PhoneticTemplate>
              </RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
      <!-- Second rule, on segments the first rule never touches (o, u, d): the same shape with a quantifier group of TWO children,
           (c d){1,2} t. A reversal that left the two children in document order would read the group as d then c. -->
      <PhonologicalRule id="prRtlBq2_bounded-quantifier" multipleApplicationOrder="rightToLeftIterative">
        <Name>rtlMultiChildQuantifierDemo_bounded-quantifier</Name>
        <PhoneticInput>
