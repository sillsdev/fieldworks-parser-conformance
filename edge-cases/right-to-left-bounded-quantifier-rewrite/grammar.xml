                <PhoneticTemplate>
                  <PhoneticSequence>
                    <OptionalSegmentSequence min="1" max="2">
                      <SimpleContext naturalClass="ncCons_bounded-quantifier"/>
                      <SimpleContext naturalClass="ncD_bounded-quantifier"/>
                    </OptionalSegmentSequence>
                    <SimpleContext naturalClass="ncTrig_bounded-quantifier"/>
                  </PhoneticSequence>
                </PhoneticTemplate>
              </RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
      <PhonologicalRule id="prRtlAnchor_anchor-environment" multipleApplicationOrder="rightToLeftIterative">
        <Name>rtlAnchorDemo_anchor-environment</Name>
        <PhoneticInput>
          <PhoneticSequence>
            <SimpleContext naturalClass="ncA_anchor-environment"/>
