    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prRtlBq_bounded-quantifier" multipleApplicationOrder="rightToLeftIterative">
        <Name>rtlBoundedQuantifierDemo_bounded-quantifier</Name>
        <PhoneticInput>
          <PhoneticSequence>
            <SimpleContext naturalClass="ncVowel_bounded-quantifier"/>
          </PhoneticSequence>
        </PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput>
