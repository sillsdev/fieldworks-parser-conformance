                    <SimpleContext naturalClass="ncE_anchor-environment"/>
                  </PhoneticSequence>
                </PhoneticTemplate>
              </LeftEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
