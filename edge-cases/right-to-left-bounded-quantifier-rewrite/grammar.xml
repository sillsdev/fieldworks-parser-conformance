            </PhoneticOutput>
            <Environment>
              <RightEnvironment>
                <PhoneticTemplate finalBoundaryCondition="true">
                  <PhoneticSequence/>
                </PhoneticTemplate>
              </RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
      <!-- Spreading rule: "a" becomes "e" immediately after an "e". Applied iteratively, each
           rewrite can feed the NEXT candidate position's own left environment, so the scan direction
           decides how far the spread reaches in a single pass, unlike prRtlAnchor above, whose
           anchored environment can only ever match once regardless of direction: that is why
           prRtlAnchor alone never evidenced this fixture's own headline multipleApplicationOrder
           value, and why ROOT3 exists to give it a rule where direction actually changes the result. -->
      <PhonologicalRule id="prSpread_anchor-environment" multipleApplicationOrder="rightToLeftIterative">
        <Name>spreadEAfterE_anchor-environment</Name>
        <PhoneticInput>
          <PhoneticSequence>
            <SimpleContext naturalClass="ncA_anchor-environment"/>
