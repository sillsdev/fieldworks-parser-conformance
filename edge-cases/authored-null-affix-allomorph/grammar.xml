<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<!-- A user-authored null suffix as FieldWorks stores it: the lexical entry's affix allomorph has the form
     "∅" (U+2205), which HCLoader.LoadFormAffixProcessAllomorph writes as the insertion "+∅". The table
     declares ∅ as a null boundary (HCLoader.LoadCharacterDefinitionTable), so the morph contributes no
     segment to the word. The tense entry has the null allomorph in a left environment (after n) and the
     overt -ta in the other (after t); a second entry, a zero relative marker, has only the null allomorph.
     Both fill required template slots. The table also holds a real segment 0, which the null form must
     never match. -->
<HermitCrabInput>
  <Language>
    <Name>AuthoredNullAffixAllomorph</Name>
    <PartsOfSpeech><PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech></PartsOfSpeech>
    <CharacterDefinitionTable id="table1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cU"><Representations><Representation>u</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cN"><Representations><Representation>n</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cT"><Representations><Representation>t</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cZero"><Representations><Representation>0</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="bNull"><Representations><Representation>^0</Representation><Representation>*0</Representation><Representation>&amp;0</Representation><Representation>∅</Representation></Representations></BoundaryDefinition>
        <BoundaryDefinition id="bPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
      <SegmentNaturalClass id="ncN"><Name>n</Name><Segment segment="cN" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncT"><Name>t</Name><Segment segment="cT" /></SegmentNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="table1" morphologicalRuleOrder="unordered">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrPst" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV"><Name>PST</Name><MorphologicalSubrules><MorphologicalSubrule id="subPstNull"><MorphologicalInput><PhoneticSequence id="subPstNull_stem"><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bNull" /><BoundaryMarker boundary="bPlus" /></OptionalSegmentSequence><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence><SimpleContext naturalClass="ncN" /><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bPlus" /><BoundaryMarker boundary="bNull" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput><MorphologicalOutput><CopyFromInput index="subPstNull_stem" /><InsertSegments><PhoneticShape>+∅</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule><MorphologicalSubrule id="subPstTa"><MorphologicalInput><PhoneticSequence id="subPstTa_stem"><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bNull" /><BoundaryMarker boundary="bPlus" /></OptionalSegmentSequence><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence><SimpleContext naturalClass="ncT" /><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bPlus" /><BoundaryMarker boundary="bNull" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput><MorphologicalOutput><CopyFromInput index="subPstTa_stem" /><InsertSegments><PhoneticShape>+ta</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule></MorphologicalSubrules><MorphemeId>PST</MorphemeId></MorphologicalRule>
          <MorphologicalRule id="mrRel" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV"><Name>REL</Name><MorphologicalSubrules><MorphologicalSubrule id="subRel"><MorphologicalInput><PhoneticSequence id="subRel_stem"><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bNull" /><BoundaryMarker boundary="bPlus" /></OptionalSegmentSequence><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence><OptionalSegmentSequence min="0" max="-1"><BoundaryMarker boundary="bPlus" /><BoundaryMarker boundary="bNull" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput><MorphologicalOutput><CopyFromInput index="subRel_stem" /><InsertSegments><PhoneticShape>+∅</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule></MorphologicalSubrules><MorphemeId>REL</MorphemeId></MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate requiredPartsOfSpeech="posV">
            <Name>verbTemplate</Name>
            <Slot morphologicalRules="mrPst"><Name>tense</Name></Slot>
            <Slot morphologicalRules="mrRel"><Name>relative</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="eKaun" partOfSpeech="posV"><Allomorphs><Allomorph id="aKaun"><PhoneticShape>kaun</PhoneticShape></Allomorph></Allomorphs><MorphemeId>KAUN</MorphemeId><Gloss>KAUN</Gloss></LexicalEntry>
          <LexicalEntry id="eKat" partOfSpeech="posV"><Allomorphs><Allomorph id="aKat"><PhoneticShape>kat</PhoneticShape></Allomorph></Allomorphs><MorphemeId>KAT</MorphemeId><Gloss>KAT</Gloss></LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
