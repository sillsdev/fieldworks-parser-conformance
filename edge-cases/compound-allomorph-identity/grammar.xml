          <FeatureValue feature="f_separated" symbolValues="fP_separated"/>
          <FeatureValue feature="g_separated" symbolValues="gP_separated"/>
          <FeatureValue feature="cell" symbolValues="cell_separated"/>
        </SegmentDefinition>
        <SegmentDefinition id="cP_separated">
          <Representations>
            <Representation>d</Representation>
          </Representations>
          <FeatureValue feature="f_separated" symbolValues="fM_separated"/>
          <FeatureValue feature="g_separated" symbolValues="gM_separated"/>
          <FeatureValue feature="cell" symbolValues="cell_separated"/>
