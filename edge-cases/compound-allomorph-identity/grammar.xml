      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="any_plain">
        <Name>Any_plain</Name>
        <FeatureValue feature="cell" symbolValues="cell_plain"/>
