      <FeatureNaturalClass id="any_separated">
        <Name>Any_separated</Name>
        <FeatureValue feature="cell" symbolValues="cell_separated"/>
      </FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="t_plain" morphologicalRuleOrder="unordered" morphologicalRules="cr1_plain cr1_separated PRE_separated">
        <Name>Main_plain</Name>
        <MorphologicalRuleDefinitions>
          <CompoundingRule id="cr1_plain">
            <Name>Compound_plain</Name>
            <CompoundingSubrules>
              <CompoundingSubrule>
                <HeadMorphologicalInput>
                  <PhoneticSequence id="h0_plain">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="any_plain"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </HeadMorphologicalInput>
                <NonHeadMorphologicalInput>
                  <PhoneticSequence id="n0_plain">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="any_plain"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </NonHeadMorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="h0_plain"/>
                  <CopyFromInput index="n0_plain"/>
                </MorphologicalOutput>
              </CompoundingSubrule>
            </CompoundingSubrules>
          </CompoundingRule>
          <CompoundingRule id="cr1_separated">
            <Name>Compound_separated</Name>
            <CompoundingSubrules>
              <CompoundingSubrule>
                <HeadMorphologicalInput>
                  <PhoneticSequence id="h0_separated">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="any_separated"/>
