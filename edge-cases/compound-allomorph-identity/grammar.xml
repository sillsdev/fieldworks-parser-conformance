                  <CopyFromInput index="n0_separated"/>
                </MorphologicalOutput>
              </CompoundingSubrule>
            </CompoundingSubrules>
          </CompoundingRule>
          <MorphologicalRule id="PRE_separated" requiredPartsOfSpeech="v_separated" multipleApplication="1">
            <Name>PRE_separated</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="PRE0_separated">
                <MorphologicalInput>
                  <PhoneticSequence id="PREStem0_separated">
                    <OptionalSegmentSequence min="1" max="-1">
                      <SimpleContext naturalClass="any_separated"/>
                    </OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <InsertSegments>
                    <PhoneticShape>d^0</PhoneticShape>
                  </InsertSegments>
                  <CopyFromInput index="PREStem0_separated"/>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>PRE_separated</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
