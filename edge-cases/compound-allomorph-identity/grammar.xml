            <Representation>p</Representation>
          </Representations>
          <FeatureValue feature="f_plain" symbolValues="fM_plain"/>
          <FeatureValue feature="g_plain" symbolValues="gM_plain"/>
          <FeatureValue feature="cell" symbolValues="cell_plain"/>
        </SegmentDefinition>
